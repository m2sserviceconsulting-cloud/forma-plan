MONGODB_URI=mongodb://localhost:27017/planadmin
PORT=5000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Pour production : mongodb+srv://user:password@cluster.mongodb.net/planadmin

# === EMAIL (Brevo - https://app.brevo.com) ===
# 1. Créer un compte gratuit sur brevo.com
# 2. Aller dans SMTP & API > API Keys > Créer une clé
# 3. Renseigner l'email expéditeur vérifié dans Brevo
BREVO_API_KEY=xsmtpsib-VOTRE_CLE_API_BREVO_ICI
BREVO_SENDER_EMAIL=votre-email-expediteur@domaine.com

